{
  "id": "calendar",
  "version": "0.13.0",
  "apiVersion": "2.0",
  "engines": { "coongro": ">=0.72.0 <1.0.0" },
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css"
    ]
  },
  "contributes": {
    "menus": [],
    "views": [],
    "actionModules": [
      {
        "module": "./dist/actions.js",
        "export": "calendarActions",
        "prefix": "calendar.calendars",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "toggleVisibility",
          "getDefault"
        ],
        "deleteAction": "softDelete"
      },
      {
        "module": "./dist/actions.js",
        "export": "eventTypeActions",
        "prefix": "calendar.types",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "search"
        ],
        "deleteAction": "softDelete"
      },
      {
        "module": "./dist/actions.js",
        "export": "eventActions",
        "prefix": "calendar.events",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "search",
          "listByDateRange",
          "listByDate",
          "listByEntity",
          "listByCalendar",
          "listUpcoming",
          "moveEvent",
          "countByStatus",
          "countByDate",
          "countByCalendar"
        ],
        "deleteAction": "softDelete"
      }
    ],
    "settings": {
      "sections": [
        {
          "id": "calendar.selector-de-hora",
          "page": "calendar.general",
          "label": "Selector de hora",
          "order": 30,
          "items": [
            {
              "key": "calendar.timePicker.minuteStep",
              "type": "enum",
              "label": "Intervalo de minutos",
              "description": "Precisión del selector de minutos en hora exacta",
              "default": "5",
              "options": [
                "1",
                "5",
                "10",
                "15"
              ],
              "tags": [
                "calendar",
                "timepicker",
                "minutestep",
                "intervalo",
                "minutos"
              ]
            },
            {
              "key": "calendar.timePicker.use24Hour",
              "type": "boolean",
              "label": "Formato 24 horas",
              "description": "Usar formato 24h (14:00) en vez de 12h (2:00 PM)",
              "default": true,
              "tags": [
                "calendar",
                "timepicker",
                "use24hour",
                "formato",
                "horas"
              ]
            }
          ]
        }
      ],
      "groups": [
        {
          "id": "calendar",
          "label": "Calendario",
          "order": 50
        }
      ],
      "pages": [
        {
          "id": "calendar.general",
          "group": "calendar",
          "label": "General",
          "icon": "CalendarDays",
          "order": 10
        }
      ]
    }
  }
}
